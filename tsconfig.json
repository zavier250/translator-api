{
  "compilerOptions": {
    "target": "ES6",                        // 编译成 ES6 的 JS
    "module": "ESNext",                    // 支持 import/export 模块
    "moduleResolution": "node",            // 解析方式为 node 模式
    "esModuleInterop": true,               // 允许默认导入 CommonJS 模块
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,             // 如果你导入了 JSON 文件，可以开启（可选）
    "outDir": "./dist",                    // 可选：输出目录（不会被 ts-node 用）
    "baseUrl": ".",                        // 可选：路径相关配置
    "paths": {
      "*": ["node_modules/*"]
    }
  },
  "include": ["src", "index.ts"],          // 编译入口
  "exclude": ["node_modules", "dist"]      // 忽略这些目录
}
